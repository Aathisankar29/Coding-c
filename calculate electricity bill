#include <stdio.h>
int main()
{

    int unit;
    float bill;
    scanf("%d",&unit);
    if(unit<=100){
        bill=unit*0;
    }
    else if(unit<=200){
        bill=(unit-100)*2.35;
    }
    else if(unit<=400){
        bill=(100*2.35)+(unit-200)*4.70;
    }
    else if(unit<=500){
            bill=(100*2.35)+(200*4.70)+(unit-400)*6.30;
    }
    else{
        bill=(100*2.35)+(200*4.70)+(400*6.30)+(unit-500)*8.40;
    }
    printf("Bill amount:%.2f",bill);
}
